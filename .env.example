# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - NHÀ HÀNG HOÀNG LONG QUÁN (皇龍樓)
# ========================================================

# 1. Cấu hình Cổng kết nối Máy chủ
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. Khóa Bí Mật Mã Hóa JWT (JSON Web Token)
JWT_SECRET=HoangLongQuan_ImperialSecret_2026_JWT_Key#9999
JWT_EXPIRES_IN=7d

# 3. Thông tin Nhà Hàng
RESTAURANT_NAME="Hoàng Long Quán - 皇龍樓"

# 4. Cấu hình Cơ sở dữ liệu MySQL (Tùy chọn khi kết nối RDBMS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hoang_long_quan
