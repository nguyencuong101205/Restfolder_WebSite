                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/demo-accounts",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "demo-accounts"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Menu & Dishes",
      "item": [
        {
          "name": "2.1 Get All Dishes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Menu contains array of dishes\", function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["menu"]
            }
          }
        },
        {
          "name": "2.2 Filter by Category (dimsum)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"All dishes belong to dimsum category\", function () {",
                  "    jsonData.data.forEach(function(d) {",
                  "        pm.expect(d.category).to.eql('dimsum');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu?category=dimsum",
              "host": ["{{baseUrl}}"],
              "path": ["menu"],
              "query": [
                {
                  "key": "category",
                  "value": "dimsum"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Search Dishes (Keyword: vịt)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu?search=vịt",
              "host": ["{{baseUrl}}"],
              "path": ["menu"],
              "query": [
                {
                  "key": "search",
                  "value": "vịt"
                }
              ]
            }
          }
        },
        {
          "name": "2.4 Get Dish Detail by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Dish name is properly decoded Vietnamese\", function () {",
                  "    pm.expect(jsonData.data.id).to.eql('dish-01');",
                  "    pm.expect(jsonData.data.name).to.include('Há Cảo');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu/dish-01",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "dish-01"]
            }
          }
        },
        {
          "name": "2.5 Create New Dish (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"temp_dish_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Đậu Hũ Tứ Xuyên Ma Bà Hoàng Cung\",\n  \"hanzi\": \"麻婆豆腐\",\n  \"pinyin\": \"Mápó Dòufu\",\n  \"category\": \"meat\",\n  \"price\": 125000,\n  \"description\": \"Đậu hũ non mềm mịn sốt cùng thịt bò băm, ớt Tứ Xuyên và tiêu hoa tiêu tê cay nồng ấm.\",\n  \"isSpicy\": true,\n  \"spiceLevel\": 3,\n  \"isBestSeller\": true,\n  \"toppings\": [\"Thêm thịt bò băm\", \"Tăng cấp độ cay\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["menu"]
            }
          }
        },
        {
          "name": "2.6 Update Dish (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 135000,\n  \"description\": \"Đậu hũ non mềm mịn cay tê chuẩn vị hoàng cung Thành Đô.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{temp_dish_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{temp_dish_id}}"]
            }
          }
        },
        {
          "name": "2.7 Delete Dish (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu/{{temp_dish_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{temp_dish_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Tables & QR Codes",
      "item": [
        {
          "name": "3.1 Get All Tables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Returns array of dining tables\", function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tables",
              "host": ["{{baseUrl}}"],
              "path": ["tables"]
            }
          }
        },
        {
          "name": "3.2 Get Table QR Code Data URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Returns valid base64 PNG QR code\", function () {",
                  "    var qr = jsonData.data.qrDataUrl || jsonData.data.qrCode;",
                  "    pm.expect(qr).to.include('data:image/png;base64');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tables/{{current_table}}/qr",
              "host": ["{{baseUrl}}"],
              "path": ["tables", "{{current_table}}", "qr"]
            }
          }
        },
        {
          "name": "3.3 Get All Tables With QR (For Printing)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tables/all/with-qr",
              "host": ["{{baseUrl}}"],
              "path": ["tables", "all", "with-qr"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Orders & Kitchen Workflow (KDS)",
      "item": [
        {
          "name": "4.1 Place Order from Table (Customer QR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Calculates VAT 8% and subtotal properly\", function () {",
                  "    pm.expect(jsonData.data.totalPrice).to.be.above(0);",
                  "    pm.expect(jsonData.data.vat).to.be.above(0);",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"order_id\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"{{current_table}}\",\n  \"customerName\": \"Khách Bàn {{current_table}}\",\n  \"items\": [\n    {\n      \"id\": \"dish-01\",\n      \"quantity\": 2,\n      \"spiceLevel\": \"Không cay\",\n      \"selectedToppings\": [\n        {\n          \"name\": \"Thêm nước sốt sa tế đặc biệt\",\n          \"price\": 10000\n        }\n      ],\n      \"note\": \"Hấp nóng hổi\"\n    },\n    {\n      \"id\": \"dish-15\",\n      \"quantity\": 1,\n      \"spiceLevel\": \"Không cay\",\n      \"selectedToppings\": [],\n      \"note\": \"Pha ấm đầu tiên trước\"\n    }\n  ],\n  \"note\": \"Ưu tiên đem nước trà trước cho bàn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "4.2 Get Active Table Order (Customer Tracker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/table/{{current_table}}/active",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "table", "{{current_table}}", "active"]
            }
          }
        },
        {
          "name": "4.3 Get All Orders (Kitchen Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Orders array is present\", function () {",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kitchen_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "4.4 Filter Orders by Status (pending)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kitchen_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "4.5 Kitchen Updates Status to Preparing (Đang Nấu)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Order status is preparing\", function () {",
                  "    pm.expect(jsonData.data.status).to.eql('preparing');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{kitchen_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"preparing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{order_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{order_id}}", "status"]
            }
          }
        },
        {
          "name": "4.6 Call Staff from Table",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Request registered in order\", function () {",
                  "    pm.expect(jsonData.data.callStaffRequests.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestType\": \"Xin thêm nước đá & khăn ướt\",\n  \"note\": \"Bàn cần 4 ly nước đá và 4 khăn lạnh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{order_id}}/call-staff",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{order_id}}", "call-staff"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    }
  ]
}
