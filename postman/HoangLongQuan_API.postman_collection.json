{
  "info": {
    "_postman_id": "hoang-long-quan-api-collection-v1",
    "name": "🏮 Hoàng Long Quán (皇龍樓) - REST API Collection",
    "description": "Bộ sưu tập kiểm thử API cho Hệ thống Nhà hàng Hoàng Long Quán (Express MVC, JWT, QR Code Ordering & Kitchen KDS).\n\nThiết lập:\n1. Chọn Environment: 'Hoàng Long Quán - Localhost Environment'\n2. Chạy request '01. Login Admin' đầu tiên để tự động lưu Token Bearer vào biến môi trường.\n3. Base URL mặc định: http://localhost:5000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Authentication & Users",
      "item": [
        {
          "name": "1.1 Login Admin (Chủ Quán)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Login successful & token returned\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.token).to.be.a('string');",
                  "});",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"admin_token\", jsonData.data.token);",
                  "    console.log(\"Saved admin_token to environment:\", jsonData.data.token.slice(0, 15) + \"...\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập tài khoản Chủ quán (Admin) để nhận JWT Bearer Token có quyền cao nhất."
          }
        },
        {
          "name": "1.2 Login Kitchen (Bếp Trưởng)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"kitchen_token\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bep\",\n  \"password\": \"bep123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập tài khoản Bếp trưởng để điều phối món trên màn hình KDS."
          }
        },
        {
          "name": "1.3 Login Waiter (Tiểu Nhị / Phục Vụ)",
          "event": [
